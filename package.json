{
  "name": "sip-of-ghoulaid-commerce",
  "version": "1.0.0",
  "private": true,
  "description": "Stripe Checkout and PostgreSQL commerce service for Sip of Ghoulaid",
  "main": "server.js",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "stripe": "^18.0.0"
  },
  "devDependencies": {
    "prisma": "^6.6.0"
  }
}
