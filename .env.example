# Supabase: use the pooled transaction URL at runtime and DIRECT_URL for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Supabase Auth and Storage for the production admin portal.
# The anon key is browser-safe; never expose the service-role key.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_ANON_KEY="sb_publishable_REPLACE_ME"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_REPLACE_ME"
SUPABASE_STORAGE_BUCKET="product-media"
ADMIN_EMAIL_ALLOWLIST="owner@example.com"

# Server-side secrets. Never expose these in browser JavaScript.
STRIPE_SECRET_KEY="sk_test_REPLACE_ME"
STRIPE_WEBHOOK_SECRET="whsec_REPLACE_ME"

# Transactional order and support email. The From address must use a Resend-verified domain.
RESEND_API_KEY="re_REPLACE_ME"
ORDER_EMAIL_FROM="Sip of Ghoulaid <orders@sipofghoulaid.com>"
SUPPORT_EMAIL="support@sipofghoulaid.com"

# Comma-separated Stripe shipping rate IDs and ISO 3166-1 alpha-2 country codes.
STRIPE_SHIPPING_RATE_IDS="shr_REPLACE_ME"
STRIPE_ALLOWED_SHIPPING_COUNTRIES="US"
STRIPE_AUTOMATIC_TAX_ENABLED="true"
STRIPE_DEFAULT_TAX_CODE="txcd_99999999"
FREE_SHIPPING_THRESHOLD_CENTS="5000"
LOCAL_PICKUP_ENABLED="true"
LOCAL_PICKUP_NAME="Local pickup — Redlands, CA"

# Canonical HTTPS origin in production (no trailing slash).
PUBLIC_URL="http://localhost:3000"
PORT="3000"
TRUST_PROXY="false"
RESERVATION_MINUTES="31"
SEED_INVENTORY_DEFAULT="25"
