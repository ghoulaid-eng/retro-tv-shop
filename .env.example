# Copy values into your deployment provider's environment settings. Do not commit a .env file.
NODE_ENV=development
PORT=4242
PUBLIC_URL=http://localhost:4242
# Required to enable the production owner login. Keep both values in Render's secret settings.
# If either is unset, /admin.html returns 404.
OWNER_PORTAL_USERNAME=owner
OWNER_PORTAL_PASSWORD=replace_with_a_long_unique_password
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/sip_of_ghoulaid?schema=public
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Comma-separated Stripe Shipping Rate IDs created/configured in the Stripe Dashboard.
STRIPE_SHIPPING_RATE_IDS=shr_replace_me
# Comma-separated ISO 3166-1 alpha-2 countries accepted by Checkout.
STRIPE_ALLOWED_SHIPPING_COUNTRIES=US
# Minutes to hold stock while a Checkout Session is open (30-1440).
CHECKOUT_RESERVATION_MINUTES=30
