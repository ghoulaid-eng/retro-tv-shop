generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OrderStatus {
  PENDING_CHECKOUT
  CHECKOUT_CREATED
  PAID
  CANCELED
  EXPIRED
  NEEDS_REVIEW
  PROCESSING
  SHIPPED
  DELIVERED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CustomOrderStatus {
  PENDING
  REVIEWING
  ACCEPTED
  DECLINED
  COMPLETED
}

model Product {
  id            String           @id
  name          String
  handle        String           @unique
  emoji         String?
  description   String
  descriptionHtml String?
  category      String?
  subcategories String[]
  price         Decimal          @db.Decimal(12, 2)
  salePrice     Decimal?         @db.Decimal(12, 2)
  shippingPrice Decimal          @default(0) @db.Decimal(12, 2)
  shippingWeight Decimal         @default(0) @db.Decimal(12, 2)
  shippingWeightUnit String      @default("oz")
  packageSize   String?
  mustShipAlone Boolean          @default(false)
  trackInventory Boolean         @default(true)
  variantGroupName String        @default("Options")
  sourceUrl     String?
  active        Boolean          @default(true)
  variants      ProductVariant[]
  media         ProductMedia[]
  orderItems    OrderItem[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model ProductVariant {
  id         String       @id @default(cuid())
  productId  String
  name       String
  sku        String       @unique
  price      Decimal?     @db.Decimal(12, 2)
  active     Boolean      @default(true)
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory  Inventory?
  orderItems OrderItem[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([productId, name])
  @@index([productId, active])
}

model ProductMedia {
  id        String   @id @default(cuid())
  productId String
  type      String
  url       String
  alt       String?
  position  Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId, position])
}

model Inventory {
  id        String         @id @default(cuid())
  variantId String         @unique
  quantity  Int            @default(0)
  reserved  Int            @default(0)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  updatedAt DateTime       @updatedAt
}

model Order {
  id                    String        @id @default(cuid())
  status                OrderStatus   @default(PENDING_CHECKOUT)
  currency              String        @default("usd")
  subtotal              Decimal       @db.Decimal(12, 2)
  email                 String?
  customerId            String?
  stripeCheckoutSession String?       @unique
  reservationExpiresAt  DateTime?
  fulfilledAt           DateTime?
  releasedAt            DateTime?
  adminData             Json?
  fulfillmentStatus     String        @default("UNFULFILLED")
  trackingCarrier       String?
  trackingNumber        String?
  trackingUrl           String?
  shippingMethod        String?
  shippingAmount        Decimal       @default(0) @db.Decimal(12, 2)
  taxAmount             Decimal       @default(0) @db.Decimal(12, 2)
  shippingAddress       Json?
  stripeShippingRateId  String?
  shippedAt             DateTime?
  deliveredAt           DateTime?
  canceledAt            DateTime?
  refundedAt            DateTime?
  cancellationReason    String?
  items                 OrderItem[]
  payments              Payment[]
  timeline              OrderTimelineEvent[]
  supportNotes          OrderSupportNote[]
  emailDeliveries       TransactionalEmail[]
  customer              CustomerProfile? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([status, reservationExpiresAt])
  @@index([customerId, createdAt])
}

model CustomerProfile {
  id                   String   @id
  email                String   @unique
  name                 String
  username             String?
  contactMethod        String?
  contactInfo          String?
  shippingFullName     String?
  shippingAddressLine1 String?
  shippingAddressLine2 String?
  shippingCity         String?
  shippingState        String?
  shippingPostalCode   String?
  shippingCountry      String?
  stripeCustomerId     String?  @unique
  orders               Order[]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model OrderItem {
  id             String         @id @default(cuid())
  orderId        String
  productId      String
  variantId      String
  name           String
  variant        String
  unitPrice      Decimal        @db.Decimal(12, 2)
  quantity       Int
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id])
  productVariant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
}

model Payment {
  id                      String        @id @default(cuid())
  orderId                 String
  provider                String        @default("stripe")
  providerPaymentIntentId String?       @unique
  amount                  Decimal       @db.Decimal(12, 2)
  currency                String
  status                  PaymentStatus @default(PENDING)
  paidAt                  DateTime?
  reference               String?
  notes                   String?
  refundAmount            Decimal       @default(0) @db.Decimal(12, 2)
  providerRefundId         String?       @unique
  refundPending            Boolean       @default(false)
  order                   Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  @@index([orderId, status])
}

model OrderTimelineEvent {
  id         String   @id @default(cuid())
  orderId    String
  type       String
  message    String
  actorEmail String?
  metadata   Json?
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([orderId, createdAt])
}

model OrderSupportNote {
  id              String   @id @default(cuid())
  orderId         String
  authorEmail     String
  message         String
  source          String
  customerVisible Boolean  @default(false)
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@index([orderId, createdAt])
}

model TransactionalEmail {
  id                String   @id @default(cuid())
  orderId           String
  type              String
  recipient         String
  subject           String
  status            String
  providerMessageId String?
  error             String?
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  sentAt            DateTime?

  @@index([orderId, createdAt])
  @@unique([orderId, type])
}

model WebhookEvent {
  id          String   @id
  type        String
  payload     Json
  processedAt DateTime?
  error       String?
  createdAt   DateTime @default(now())
}

model CustomOrderRequest {
  id                     String            @id @default(cuid())
  status                 CustomOrderStatus @default(PENDING)
  fullName               String
  username               String
  contactMethod          String
  contactInfo            String
  customizationLevel     String
  description            String
  refImages              String?
  colors                 String?
  handPaintedDetails     String?
  scents                 String[]
  glitter                Boolean           @default(false)
  glow                   Boolean           @default(false)
  additionalSets         String?
  additionalSetCount     String?
  deadline               String?
  additionalInfo         String?
  preferredPaymentMethod String?
  adminData              Json?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@index([status, createdAt])
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("monthly-mystery-box")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model AdminResource {
  key       String   @id
  value     Json
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminEmail String
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([adminEmail, createdAt])
  @@index([resource, resourceId])
}
