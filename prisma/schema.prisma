generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OrderStatus {
  PENDING_CHECKOUT
  CHECKOUT_CREATED
  PAID
  CANCELED
  EXPIRED
  NEEDS_REVIEW
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CustomOrderStatus {
  PENDING
  REVIEWING
  ACCEPTED
  DECLINED
  COMPLETED
}

model Product {
  id            String           @id
  name          String
  emoji         String?
  description   String
  category      String?
  subcategories String[]
  price         Decimal          @db.Decimal(12, 2)
  salePrice     Decimal?         @db.Decimal(12, 2)
  active        Boolean          @default(true)
  variants      ProductVariant[]
  media         ProductMedia[]
  orderItems    OrderItem[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model ProductVariant {
  id         String       @id @default(cuid())
  productId  String
  name       String
  sku        String       @unique
  price      Decimal?     @db.Decimal(12, 2)
  active     Boolean      @default(true)
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory  Inventory?
  orderItems OrderItem[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([productId, name])
  @@index([productId, active])
}

model ProductMedia {
  id        String   @id @default(cuid())
  productId String
  type      String
  url       String
  alt       String?
  position  Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId, position])
}

model Inventory {
  id        String         @id @default(cuid())
  variantId String         @unique
  quantity  Int            @default(0)
  reserved  Int            @default(0)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  updatedAt DateTime       @updatedAt
}

model Order {
  id                    String        @id @default(cuid())
  status                OrderStatus   @default(PENDING_CHECKOUT)
  currency              String        @default("usd")
  subtotal              Decimal       @db.Decimal(12, 2)
  email                 String?
  stripeCheckoutSession String?       @unique
  reservationExpiresAt  DateTime?
  fulfilledAt           DateTime?
  releasedAt            DateTime?
  items                 OrderItem[]
  payments              Payment[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([status, reservationExpiresAt])
}

model OrderItem {
  id             String         @id @default(cuid())
  orderId        String
  productId      String
  variantId      String
  name           String
  variant        String
  unitPrice      Decimal        @db.Decimal(12, 2)
  quantity       Int
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id])
  productVariant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
}

model Payment {
  id                      String        @id @default(cuid())
  orderId                 String
  provider                String        @default("stripe")
  providerPaymentIntentId String?       @unique
  amount                  Decimal       @db.Decimal(12, 2)
  currency                String
  status                  PaymentStatus @default(PENDING)
  paidAt                  DateTime?
  order                   Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  @@index([orderId, status])
}

model WebhookEvent {
  id          String   @id
  type        String
  payload     Json
  processedAt DateTime?
  error       String?
  createdAt   DateTime @default(now())
}

model CustomOrderRequest {
  id                     String            @id @default(cuid())
  status                 CustomOrderStatus @default(PENDING)
  fullName               String
  username               String
  contactMethod          String
  contactInfo            String
  customizationLevel     String
  description            String
  refImages              String?
  colors                 String?
  handPaintedDetails     String?
  scents                 String[]
  glitter                Boolean           @default(false)
  glow                   Boolean           @default(false)
  additionalSets         String?
  additionalSetCount     String?
  deadline               String?
  additionalInfo         String?
  preferredPaymentMethod String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@index([status, createdAt])
}
