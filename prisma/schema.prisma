generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  EXPIRED
  CANCELED
}

enum CustomOrderRequestStatus {
  NEW
  IN_REVIEW
  QUOTED
  CLOSED
}

model Product {
  id                String      @id
  name              String
  description       String
  imageUrl          String?
  currency          String      @default("usd")
  priceCents        Int
  inventoryQuantity Int
  reservedQuantity  Int         @default(0)
  active            Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  orderItems        OrderItem[]
  options           ProductOption[]
  variants          ProductVariant[]

  @@index([active])
}

model ProductOption {
  id        String   @id @default(cuid())
  productId String
  name      String
  values    Json
  position  Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name])
  @@index([productId, position])
}

model ProductVariant {
  id                String      @id
  productId         String
  name              String
  optionValues      Json
  priceCents        Int
  inventoryQuantity Int
  reservedQuantity  Int         @default(0)
  active            Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  product           Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderItems        OrderItem[]

  @@index([productId, active])
}

model Order {
  id                      String      @id @default(cuid())
  status                  OrderStatus @default(PENDING_PAYMENT)
  currency                String      @default("usd")
  subtotalCents           Int
  stripeCheckoutSessionId String?     @unique
  reservationExpiresAt    DateTime
  paidAt                  DateTime?
  customerEmail           String?
  shippingName            String?
  shippingAddress         Json?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt
  items                   OrderItem[]

  @@index([status, reservationExpiresAt])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  productId      String
  productName    String
  variantId      String?
  variantName    String?
  variantOptions Json?
  unitPriceCents Int
  quantity       Int
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product        Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model CustomOrderRequest {
  id                String                   @id @default(cuid())
  status            CustomOrderRequestStatus @default(NEW)
  customerName      String
  customerUsername  String
  contactMethod     String
  contactInfo       String
  customizationLevel String
  details           Json
  formspreeDelivered Boolean                  @default(false)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([status, createdAt])
}
